# Configuração do deploy na nuvem (scripts/deploy_aci.sh).
# Copie para .env.cloud (que o Git ignora) e preencha. Nunca versione o .env.cloud.

# ---------- Azure (mesmos recursos do gs2-devops) ----------
# AZ_SUBSCRIPTION_ID=            # opcional: só se você tiver mais de uma assinatura
AZ_RESOURCE_GROUP=rg-sampatech
ACR_NAME=acrsampatechgs2devops
ACI_NAME=aci-sampatech-ia
# Vira o endereço: http://<ACI_DNS_LABEL>.<região>.azurecontainer.io:8000
ACI_DNS_LABEL=sampatech-ia-gs2devops
# ACI_CPU=1
# ACI_MEMORY_GB=2

# ---------- Serviço de IA ----------
# Chave da nuvem: DIFERENTE da local. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
IA_API_KEY=

# LLM (os mesmos do .env local)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_API_KEY=
LLM_TIMEOUT_SECONDS=30

# ---------- Integração com a .NET e o Blob (próxima fase; vazio = desligado) ----------
DOTNET_API_URL=
IA_USERNAME=
IA_PASSWORD=
BLOB_CONNECTION_STRING=
BLOB_CONTAINER=frames
BLOB_PREFIX=
ISSUE_TYPE_ID_BURACO=
ISSUE_TYPE_ID_FAIXA_APAGADA=
ISSUE_TYPE_ID_POSTE_APAGADO=
ISSUE_TYPE_ID_VIA_ALAGADA=
