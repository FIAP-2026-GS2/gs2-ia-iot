# Copie para .env e preencha. O .env nunca vai para o Git (está no .gitignore).
# Variável vazia = não configurada (a integração fica desligada).

# local | cloud | test
APP_ENV=local

# Chave das rotas da IA (header X-API-Key), com pelo menos 16 caracteres.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
IA_API_KEY=

# --- API .NET (usuário com papel IA_SERVICE) ---
# Local: http://localhost:5242 · Nuvem: http://sampatech-gs2devops.centralus.azurecontainer.io:8080
DOTNET_API_URL=
IA_USERNAME=
IA_PASSWORD=

# --- Azure Blob Storage (imagens já borradas) ---
# az storage account show-connection-string -g rg-sampatech -n stsampatechgs2devops --query connectionString -o tsv
BLOB_CONNECTION_STRING=
BLOB_CONTAINER=frames
# Local: dev/ · Nuvem: vazio
BLOB_PREFIX=dev/

# --- IDs da tabela ISSUE_TYPE (na nuvem: 1, 2, 3 e 4; no local, confira) ---
ISSUE_TYPE_ID_BURACO=
ISSUE_TYPE_ID_FAIXA_APAGADA=
ISSUE_TYPE_ID_POSTE_APAGADO=
ISSUE_TYPE_ID_VIA_ALAGADA=

# --- LLM principal (Groq, padrão OpenAI) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=
LLM_API_KEY=

# --- LLM reserva (Gemini, padrão OpenAI) ---
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

# Tempo limite de cada chamada ao LLM, em segundos.
LLM_TIMEOUT_SECONDS=30
